APP_NAME="VAANIRAKSHAK AI Threat Engine"
APP_VERSION="1.0.0-SIH2026"
DEBUG=true

# Redis (optional — system falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SEC=1800

# Database (SQLite for demo; swap to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./vaanirakshak.db

# Security
SECRET_KEY=vaanirakshak-sih2026-change-this-in-production
ALGORITHM=HS256

# Defense Policy Thresholds (decoupled from ML models)
INTERVENTION_WINDOW_SEC=10
RISK_THRESHOLD_CRITICAL=90
RISK_THRESHOLD_HIGH=80
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_LOW=30

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_DURATION_SEC=1.0
