# VaaniRakshak — environment configuration template
# Copy to .env and fill in real values locally. NEVER commit .env.
# (Rules.md section 12: no hard-coded secrets; commit only .env.example.)

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Backend / API ---
API_V1_PREFIX=/v1
JWT_SECRET=changeme-generate-a-real-secret-locally
JWT_ALGORITHM=HS256
CRITICAL_CONFIRMATION_WINDOW_SECONDS=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Database (Supabase/PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://vaanirakshak:vaanirakshak@postgres:5432/vaanirakshak
POSTGRES_USER=vaanirakshak
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=vaanirakshak

# --- Supabase (if used instead of/alongside self-hosted Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard ---
VITE_API_BASE_URL=http://localhost:8000

# --- ML / model providers (introduced Phase 3+, left blank in Phase 0) ---
HUGGINGFACE_TOKEN=
MODEL_REGISTRY_PATH=./models/registry

# --- Attack Lab (Phase 1) ---
ATTACK_LAB_ENABLED=true
ATTACK_LAB_REQUIRE_CONSENT=true
